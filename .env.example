# Local development defaults. The launcher loads this file when copied to .env.
MSAIE_MCP_TRANSPORT=inprocess
MSAIE_INDEX_PATH=.data/rag_index.sqlite3
MSAIE_ACTION_LOG=.data/mock-actions.jsonl

# Local learned embeddings; the model downloads on first index build.
MSAIE_EMBEDDING_PROVIDER=huggingface
MSAIE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MSAIE_EMBEDDING_BATCH_SIZE=32
# MSAIE_EMBEDDING_TIMEOUT_SECONDS=120
# MSAIE_EMBEDDING_MAX_RETRIES=3

# Required response-generation step for every citation-backed answer. The application tries three pinned free models
# in order, then uses openrouter/free as the last fallback. The content-safety model is a classifier, not a composer.
# Existing legacy OPENROUTER_API_KEY is also accepted when MSAIE_LLM_API_KEY is not set.
MSAIE_LLM_BASE_URL=https://openrouter.ai/api/v1
MSAIE_LLM_API_KEY=
MSAIE_LLM_FALLBACK_MODEL=openrouter/free
# Per-model timeout is capped at 12 seconds to leave room for RAG/MCP under the public request deadline.
# MSAIE_LLM_TIMEOUT_SECONDS=12

# Optional remote serving of the same MiniLM model. Embeddings use only these variables;
# required answer generation uses MSAIE_LLM_* variables above.
# MSAIE_EMBEDDING_PROVIDER=openrouter
# MSAIE_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# MSAIE_EMBEDDING_API_KEY=
# MSAIE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
