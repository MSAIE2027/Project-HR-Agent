# Local development defaults. The launcher loads this file when copied to .env.
MSAIE_MCP_TRANSPORT=inprocess
MSAIE_INDEX_PATH=.data/rag_index.sqlite3
MSAIE_ACTION_LOG=.data/mock-actions.jsonl

# Local learned embeddings; the model downloads on first index build.
MSAIE_EMBEDDING_PROVIDER=huggingface
MSAIE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MSAIE_EMBEDDING_BATCH_SIZE=32
# MSAIE_EMBEDDING_TIMEOUT_SECONDS=120
# MSAIE_EMBEDDING_MAX_RETRIES=3

# Required response-generation step for every citation-backed answer. The application tries two
# metered routes in order (nvidia/nemotron-3-nano-30b-a3b, then qwen/qwen-2.5-7b-instruct), then the
# three zero-priced routes, then openrouter/free as the last OpenRouter fallback. The metered tier is
# first because the account-wide free daily quota returns 429 before any completion exists; the free
# routes remain configured so a live answer is still reachable with no credit. Safeguard-tuned models
# are excluded because they hedge and the answer validator requires binding status language.
# Existing legacy OPENROUTER_API_KEY is also accepted when MSAIE_LLM_API_KEY is not set.
MSAIE_LLM_BASE_URL=https://openrouter.ai/api/v1
MSAIE_LLM_API_KEY=
MSAIE_LLM_FALLBACK_MODEL=openrouter/free
# OpenCode Zen is attempted after the OpenRouter model chain fails or reports an account-wide quota cap.
# These IDs are currently zero-priced, limited-time routes; verify availability and account access before a demo.
# This list may reorder or select a subset of the code allowlist; add new model IDs through a reviewed code/test change.
OPENCODE_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODELS=nemotron-3.5-lightning-free,big-pickle,space-bunny-free
# Per OpenCode model timeout is capped at 12 seconds; free-tier generations are slow enough that an
# 8s cap truncated them. Worst case for the full cascade is 3 x 15s + 3 x 12s = 81s before RAG/MCP.
OPENCODE_ZEN_TIMEOUT_SECONDS=12
# Per OpenRouter model timeout is capped at 15 seconds to leave room for RAG/MCP under the request deadline.
MSAIE_LLM_TIMEOUT_SECONDS=15

# Optional remote serving of the same MiniLM model. Embeddings use only these variables;
# required answer generation uses MSAIE_LLM_* variables above.
# MSAIE_EMBEDDING_PROVIDER=openrouter
# MSAIE_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# MSAIE_EMBEDDING_API_KEY=
# MSAIE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
